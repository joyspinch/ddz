using System;
using Game.Foundation;

// 设置基座的项目侧断言：
//   - 默认值来自声明；
//   - 非法值被忽略（基座负责，游戏侧不该崩也不该写坏配置）；
//   - 设置真的落盘（test.ps1 跑两遍：首跑写、次跑读回）。
public class DzSettingsCheck {
    static void Main() {
        DzSettings.Ensure();
        Console.WriteLine("diff=" + Convert.ToString(DzSettings.AiDiffIndex()));
        DzSettings.SetAiDiffIndex(2);
        DzSettings.Base().SetOption("aiDiff", "nightmare");   // 候选外：必须被忽略
        Console.WriteLine("after=" + Convert.ToString(DzSettings.AiDiffIndex()));
        Console.WriteLine("settings OK");
    }
}
